# Railway operator authentication. Generate this; never commit a real value.
OPERATOR_PASSWORD=

# Cloudflare user API token and account. See railway/TEMPLATE_README.md for minimum permissions.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Stable, unique lowercase Worker prefix. Do not change after the first deploy.
CLOUDFLARE_OS_PREFIX=my-company-os

# Exact Access-protected origin. Either a Custom Domain or the router's workers.dev hostname.
CLOUDFLARE_OS_PUBLIC_URL=https://my-company-os-router.example.workers.dev
CLOUDFLARE_ACCESS_ISSUER=https://my-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=
CLOUDFLARE_OS_ADMIN_EMAIL=admin@example.com

# Optional. This one-phase operator supports only an in-account gateway. Anthropic/OpenAI keys are
# stored on AI Gateway; Google needs a separate Workshop secret and is intentionally unsupported.
CLOUDFLARE_AI_GATEWAY_NAME=default
CLOUDFLARE_AI_GATEWAY_PROVIDERS=cloudflare

# Optional display copy for the starter's example custom Gatekeeper.
CLOUDFLARE_OS_ORGANIZATION_NAME=Organization Context
CLOUDFLARE_OS_ORGANIZATION_GUIDANCE=Use organization context only when explicitly enabled.
